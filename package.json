{
	"name": "cloudbase-mcp-worker",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --config wrangler.hosted-oauth-staging.jsonc",
		"deploy:hosted": "wrangler deploy --config wrangler.hosted-oauth-staging.jsonc",
		"deploy:direct-v2": "wrangler deploy --config wrangler.direct-v2.jsonc",
		"dev": "wrangler dev --config wrangler.hosted-oauth-staging.jsonc",
		"start": "wrangler dev --config wrangler.hosted-oauth-staging.jsonc",
		"dev:direct-v2": "wrangler dev --config wrangler.direct-v2.jsonc",
		"format": "oxfmt --write .",
		"lint:fix": "oxlint --fix",
		"cf-typegen": "wrangler types --config wrangler.hosted-oauth-staging.jsonc",
		"cf-typegen:direct-v2": "wrangler types worker-configuration.direct-v2.d.ts --config wrangler.direct-v2.jsonc --env-interface DirectV2Env --include-runtime false",
		"check:direct-v2": "tsc --noEmit && wrangler deploy --dry-run --config wrangler.direct-v2.jsonc --outdir dist/direct-v2",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudbase/cals": "^1.2.23",
		"@cloudbase/cloudbase-mcp": "2.34.4",
		"@cloudbase/functions-framework": "^1.14.0",
		"@cloudbase/manager-node": "5.8.8",
		"@cloudbase/mcp": "1.0.0-beta.25",
		"@cloudbase/toolbox": "^0.8.4",
		"@cloudflare/workers-oauth-provider": "^0.8.3",
		"@modelcontextprotocol/sdk": "1.30.0",
		"adm-zip": "0.6.0",
		"cors": "^2.8.5",
		"express": "5.1.0",
		"fd-slicer": "^1.1.0",
		"hono": "^4.13.8",
		"lockfile": "^1.0.4",
		"octokit": "^5.0.5",
		"open": "^10.1.2",
		"punycode": "^2.3.1",
		"unzipper": "^0.12.3",
		"winston": "^3.15.0",
		"winston-daily-rotate-file": "^5.0.0",
		"ws": "8.21.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"oxfmt": "^0.56.0",
		"oxlint": "^1.83.0",
		"typescript": "6.0.3",
		"wrangler": "^4.135.0"
	}
}
