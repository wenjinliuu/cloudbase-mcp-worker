/**
 * CloudBase MCP Worker
 * GitHub OAuth protects /mcp. OAuth state is stored in Cloudflare KV.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbase-mcp-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-02",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "4e8f692f3d724c629da5ebce271210f2"
		}
	],
	"observability": {
		"enabled": true
	}
}
