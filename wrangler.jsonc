/**
 * Private CloudBase MCP gateway
 * ChatGPT -> GitHub OAuth -> Cloudflare Worker -> Tencent Hosted MCP
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbase-mcp-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23libkN7B3D45CTXve",
		"CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1"
	},
	"secrets": {
		"required": [
			"GITHUB_CLIENT_SECRET",
			"COOKIE_ENCRYPTION_KEY",
			"CLOUDBASE_API_KEY"
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"deleted_classes": ["MyMCP"],
			"tag": "v2"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "4e8f692f3d724c629da5ebce271210f2"
		}
	],
	"observability": {
		"enabled": true
	}
}
