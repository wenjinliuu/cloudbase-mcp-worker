{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbase-mcp-direct-v2",
	"main": "src/direct-v2.ts",
	"compatibility_date": "2026-09-19",
	"preview_urls": false,
	"keep_vars": true,
	"alias": {
		"@aws-sdk/client-s3": "./src/stubs/aws-s3.ts",
	},
	"vars": {
		"CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1",
		"CLOUDBASE_MCP_CLOUD_MODE": "true",
		"CLOUDBASE_MCP_TELEMETRY_DISABLED": "true",
		"TCB_LANG": "zh",
		"TCB_SITE": "domestic",
	},
	"secrets": {
		"required": [
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"COOKIE_ENCRYPTION_KEY",
			"CLOUDBASE_API_KEY",
		],
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "bd19f849e53b4a94936dd59c8a07369d",
		},
	],
	"observability": {
		"enabled": true,
	},
}