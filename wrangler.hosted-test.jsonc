{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbase-hosted-mcp-test",
	"main": "src/hosted-test.ts",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"vars": {
		"CLOUDBASE_ENV_ID": "wenjin-cloudbase-d1empq882391ac1"
	},
	"migrations": [
		{
			"new_sqlite_classes": ["HostedMCPTest"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "HostedMCPTest",
				"name": "MCP_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}
